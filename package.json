{
  "name": "@clab/omp-agi-runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AGI runtime for OMP as a persistent extension layer: journal, recovery, evidence, memory outbox. Zero core patches.",
  "engines": {
    "node": ">=22.16.0",
    "bun": ">=1.3.14"
  },
  "omp": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc -p .",
    "install-extension": "node scripts/install.mjs",
    "compat": "node --experimental-strip-types scripts/compat.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs"
  },
  "exports": {
    ".": "./src/kernel.mjs",
    "./memory": "./src/memory.mjs",
    "./store": "./src/store.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steve-8000/agi-runtime.git"
  }
}
