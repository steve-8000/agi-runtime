{
  "name": "@clab/omp-agi-runtime",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "OMP-native engineering runtime: bounded request context, optional journal and autonomous read-back recovery. No work budgets or retrieval gates.",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "omp": {
    "extensions": [
      "./extension/index.mjs"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:runtime": "node --test tests/runtime.test.mjs tests/extension.test.mjs tests/memory.test.mjs",
    "test:live": "node scripts/live-probe.mjs",
    "check": "node scripts/check.mjs",
    "measure": "node scripts/measure.mjs",
    "install-extension": "node scripts/install.mjs",
    "upgrade-check": "node scripts/upgrade-check.mjs",
    "install-ompupdate-alias": "node scripts/install-ompupdate-alias.mjs"
  },
  "exports": {
    ".": "./src/kernel.mjs"
  }
}
